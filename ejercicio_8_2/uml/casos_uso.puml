@startuml casos_uso
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Estudiante" as estudiante

rectangle "Aplicacion Notas (ejercicio 8.2)" {
  usecase "Ingresar cinco notas" as UC1
  usecase "Calcular estadisticas" as UC2
  usecase "Consultar promedio" as UC3
  usecase "Consultar desviacion estandar" as UC4
  usecase "Consultar nota mayor" as UC5
  usecase "Consultar nota menor" as UC6
  usecase "Limpiar formulario" as UC7
  usecase "Recibir alerta por campo vacio" as UC8
  usecase "Recibir alerta por dato no numerico" as UC9
}

estudiante --> UC1
estudiante --> UC2
estudiante --> UC7

UC2 ..> UC1 : <<include>>
UC2 ..> UC3 : <<include>>
UC2 ..> UC4 : <<include>>
UC2 ..> UC5 : <<include>>
UC2 ..> UC6 : <<include>>

UC8 ..> UC2 : <<extend>>
UC9 ..> UC2 : <<extend>>

note right of UC2
  Solo calcula si las cinco
  notas estan presentes y
  son valores numericos.
end note

@enduml
